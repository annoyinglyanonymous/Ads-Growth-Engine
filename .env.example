# Ads Growth Engine -- the intelligence side of the ads system.
#
# This repo READS growth-engine's data and WRITES only its own `ads` schema.
# It never writes public.*, and it has no path that applies a migration.
#
# Copy to .env and fill in. .env is gitignored; .env.example is not, so no
# real value ever belongs below this line.


# ---------------------------------------------------------------------------
# ADS_DATABASE_URL -- the ads_owner role.
#
# Owns the `ads` schema; holds SELECT on a named list of public.* tables and
# INSERT on nothing in public. Used by exactly two things: ads_migrate.py and
# intel/record.py. Every other module in this repo is handed the RO url below
# and does not import a write primitive at all.
#
# Same Supabase instance as growth-engine's DATABASE_URL, different role.
# Port 5432 (Supavisor session mode), matching growth-engine -- transaction
# mode (6543) additionally requires prepare_threshold=None, because psycopg3
# auto-prepares after 5 executions and transaction pooling cannot hold a
# prepared statement.
# ---------------------------------------------------------------------------
ADS_DATABASE_URL=postgresql://ads_owner:<password>@<host>:5432/postgres?sslmode=require


# ---------------------------------------------------------------------------
# ADS_DATABASE_URL_RO -- the ads_reader role.
#
# SELECT on the ads.* views and EXECUTE on the ads.* functions. Nothing in
# public, and no base table in ads.
#
# REQUIRED. There is deliberately no fallback to ADS_DATABASE_URL: running as
# the owner while believing you are read-only is worse than having no second
# role at all, because the belief is what makes the write unreviewed. An unset
# value refuses to start and says so.
# ---------------------------------------------------------------------------
ADS_DATABASE_URL_RO=postgresql://ads_reader:<password>@<host>:5432/postgres?sslmode=require


# ---------------------------------------------------------------------------
# Dashboard bind. 8001 because growth-engine owns 8000.
#
# 127.0.0.1 and never localhost: on Windows `localhost` resolves ::1 first and
# uvicorn bound to 127.0.0.1 is not listening there, which presents as a
# connection refused against an app that is plainly running.
# ---------------------------------------------------------------------------
ADS_HOST=127.0.0.1
ADS_PORT=8001


# ---------------------------------------------------------------------------
# META_ACCESS_TOKEN -- optional. Only `intel live` uses it.
#
# The same Business Manager System User token growth-engine imports with,
# carrying ads_read and nothing else. `intel live` makes two structure calls
# per account -- which ads are running, at what budget -- and writes nothing
# down anywhere.
#
# REQUIRED for any data to exist. Nothing imports without it: `python -m
# meta_ads --pull` is the only thing that fills public.meta_*, and it holds
# this token. The app still starts without one and the read verbs still work,
# because they read Postgres -- so `intel status` reports the absence as a
# fact rather than refusing to run. But an install without this token is an
# install that will never have a number in it.
#
# A System User token, not a personal one. A personal token expires at 60 days
# and the failure is SILENT: the scheduled pull simply stops importing.
#
# ads_read and nothing else. Not ads_management -- this system never writes to
# an ad account and the token should not be able to.
#
# ONE COPY, since the importer moved here in 404a045. This used to be
# duplicated in growth-engine's .env because both halves called Meta; now only
# this one does, and there is a single place to rotate it.
# ---------------------------------------------------------------------------
META_ACCESS_TOKEN=
