# Secrets. Must be ignored BEFORE the first commit -- .env holds two working
# Supabase passwords in plaintext (ads_owner and ads_reader).
.env
.env.*
!.env.example

.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# intel context snapshots. Transport between a read verb and `intel record`;
# the durable copy is knowledge_snapshot on the row itself.
.intel/

# Local operational history, not source.
logs/

# Generated by scripts/export_for_llm.py. A second copy of the whole repo;
# committing it would double every future diff.
llm-export/
